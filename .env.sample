PROJECT_NAME=Report Mauto CDSBO
VERSION=1
API_V1_STR=v1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=report_mauto
API_KEY_NAME=X-API-KEY
VALID_API_KEYS=d2f4a6c1-3b9b-45a9-b78e-142ae1f3bdhe
# Logging (opsional): level, folder, dan lama simpan file rotasi harian
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30
# Server & connection pool DB (README k6 §9.1/§9.2)
# Total koneksi = APP_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) harus <= DB_CONNECTION_BUDGET
APP_HOST=0.0.0.0
APP_PORT=8013
APP_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECTION_BUDGET=100
